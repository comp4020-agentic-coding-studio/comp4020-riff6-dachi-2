---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import HomeEntrance from "../components/HomeEntrance.astro";
import SemesterTimeline from "../components/SemesterTimeline.astro";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
---

<BaseLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  mainAttrs={{ class: "doorology-home-content" }}
  {...siteConfig}
>
  <HomeEntrance slot="hero" />

  <h2 id="course-overview">What you will do</h2>
  <p>
    You will spend the semester on one object: the door. Not doors as a
    metaphor — the actual hinged, levered, signed, coded things you push,
    pull, swipe past or get stuck at several times a day without ever being
    asked to look at one closely. You will survey real doors on and around
    campus, argue in writing about what each one gets right or wrong, redesign
    one, and build the fix well enough that someone who has never met you
    could use it correctly on the first try. The artefact you leave with is a
    field guide: your own working typology of doors, illustrated with the
    ones you actually studied.
  </p>

  <h2>Who it is for</h2>
  <p>
    Anyone who has ever pulled a door marked "push," and wants to know why
    that keeps happening and whose fault it is. No design background is
    assumed, but you should already be comfortable turning a rough opinion
    into a written argument and taking a critique of your work without
    treating it as a referendum on you — Doorology runs on weekly studio
    crits, not lectures you can sit through quietly. If your idea of a
    satisfying semester project involves a tape measure, a screwdriver and a
    door that used to be worse, you are the audience.
  </p>

  <SemesterTimeline />

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The twelve-week schedule and what happens in each studio.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</BaseLayout>

<style is:global>
  body:has(.doorology-timeline) { --at-content-width: 84rem; }
  body:has(.doorology-timeline) .at-main > p { max-width: 72ch; }
  /* Same light/dark-aware contrast fix as PageLayout.astro's .at-card-title
     — --at-secondary only clears AA in light mode, --at-primary only in
     dark. This page renders through ContentLayout directly rather than
     PageLayout, so the fix has to be repeated here rather than inherited. */
  .at-card-title {
    color: light-dark(var(--at-secondary), var(--at-primary));
  }
</style>

